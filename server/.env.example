# SentinelTrace Backend Configuration Template
PROJECT_NAME="SentinelTrace — Prompt Injection Behavioral Detector"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Settings (Local SQLite vs Supabase PostgreSQL in Production)
# Local SQLite Default:
DATABASE_URL="sqlite+aiosqlite:///./sentinel_trace.db"

# Supabase Production PostgreSQL Format:
# DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Redis Settings (Local Redis vs Upstash Serverless Redis in Production)
# Local Redis Default:
REDIS_URL="redis://localhost:6379/0"

# Upstash Production Serverless Redis Format:
# REDIS_URL="rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379"

# Security & CORS
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS="*"

# Free-Tier LLM Provider Settings (gemini, groq, mock)
LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
GOOGLE_API_KEY="AIzaSyYourGoogleStudioGeminiApiKeyHere"
GROQ_API_KEY="gsk_YourGroqApiKeyHere"

# ML Model Parameters
FEATURE_VECTOR_DIM=12
ISOLATION_FOREST_CONTAMINATION=0.1
SUSPICION_DECAY_FACTOR=0.85
ANOMALY_THRESHOLD=0.65
